          <option value="ex">เลือกเพศ</option>
          <option value="1" selected>ชาย</option>
          <option value="2">หญิง</option>
          <option value="3">LGBTQ+</option>
      </select>
        
      <h2 class="h2" id="h22">ที่อยู่</h2>
        
          <label for="province">จังหวัด : </label>
