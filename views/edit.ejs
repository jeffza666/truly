      <h2 class="h2" id="h21">ข้อมูลส่วนตัว</h2>
      <div class="form-row">
        <label for="name" id="name1">ชื่อ : </label>
        <input type="text" name="name" id="name" value="Demo">
        <label for="midname">ชื่อกลาง : </label>
        <input type="text" name="midname" id="midname" value="-">
        <label for="surname" >นามสกุล : </label>
        <input type="text" name="surname" id="surname" value="User">
