          <input type="text" name="street" id="street" value="Example Rd">
          <label for="zipcode">รหัสไปรษณีย์ : </label>
          <input type="text" name="zipcode" id="zipcode" value="00000">
        
        <div class="form-row2" id="form-row2">
          <label for="district">อำเภอ : </label>
          <input type="text" name="district" id="district" value="Sample">
          <label for="about">ที่อยู่ : </label>
          <input type="text" name="about" id="about" value="Example Rd, Bangkok">
        </div>
          <a href=""><button type="config" id="config">ยืนยันการแก้ไข</button></a>
            
        
      </div>
    </div>

    
      
