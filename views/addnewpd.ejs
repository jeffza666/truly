<%- include('partials/head_newpd.ejs') %>
<nav>
    <a href="/"><img src="/img/nav/TL.png" alt="logo"></a>
</nav>
<div class="form-wrapper">
    <h2>AddNewProduct</h2>
    <form action="/store" method="post" id="#sub">
        <div class="form-control">
            <input type="text" name="ProductName" required placeholder="ProductName">
            <input type="text" name="Price" placeholder="Price">
            <input type="text" name="Desc" placeholder="Description">
        </div>
        <div class="form-control">
            <select id="Size" name="Size">
                <option disabled selected>Size</option>
                <option value="null">---</option>
                <option value="S">S</option>
                <option value="M">M</option>
                <option value="L">L</option>
                <option value="XL">XL</option>
            </select>
            <select id="type" name="TypeProduct">
                <option disabled selected>TypeProduct</option>
                <option value="Shirt">Shirt</option>
                <option value="Shoe">Pant</option>
                <option value="Accessory">Hat</option>
                <option value="Accessory">Bag</option> 
                <option value="Accessory">Necklace</option>
            </select>
        </div>
        <div class="form-control">
            <h3>Upload Picture Proudct</h3>
            <input type="file" id="image" name="image" accept="image/*" required>
        </div>
        <button type="submit" id="subnewp">AddProduct</button>
    </form>
</div>


<%- include('partials/footer.ejs') %>

